<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>redmount third-party licenses</title>
<style>
body { font-family: sans-serif; max-width: 60em; margin: 0 auto; padding: 1em; }
pre { white-space: pre-wrap; background: #f5f5f5; padding: 1em; }
</style>
</head>
<body>
<h1>Third-party licenses</h1>
<p>redmount includes the following crates.</p>
<ul>
{{#each overview}}
<li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
{{/each}}
</ul>
{{#each licenses}}
<h2 id="{{id}}">{{name}}</h2>
<p>Used by:</p>
<ul>
{{#each used_by}}
<li>{{crate.name}} {{crate.version}}</li>
{{/each}}
</ul>
<pre>{{text}}</pre>
{{/each}}
</body>
</html>
